# ===== Phase 1 (set by Vercel) =====

# FastAPI backend URL (Cloudflare Quick Tunnel — changes on each tunnel restart).
NEXT_PUBLIC_BACKEND_URL=

# Supabase project URL (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key (sb_publishable_* or legacy eyJ...).
# NEVER paste the SERVICE_ROLE key here — that lives only on the FastAPI host.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== Phase 3 — Mock Backend (dev-only) =====

# "1" enables MSW + mock Realtime; any other value (or unset) hits the real backend.
# Production deploys MUST NOT set this to "1".
NEXT_PUBLIC_USE_MOCKS=0

# Optional: force the mock job to fail at the named stage. CORE-09 testing only.
# Valid values: extracting, transcribing, diarizing, merging
# NEXT_PUBLIC_MOCK_FAIL_AT_STAGE=

# Optional: simulate N jobs ahead in the queue (PROG-04 "queued — N ahead of you" UX).
# NEXT_PUBLIC_MOCK_JOBS_AHEAD=

# ── Phase 8: Pairing + WebRTC transport ──
# Public (safe to ship in client bundle)
NEXT_PUBLIC_MIN_ENGINE_VERSION=0.2.0

# Server-only — NEVER prefix with NEXT_PUBLIC_; gitleaks pre-commit will block accidental commits
CLOUDFLARE_CALLS_TURN_KEY_ID=
CLOUDFLARE_CALLS_TURN_API_TOKEN=
SUPABASE_REALTIME_JWT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
