# .env.example
# ────────────────────────────────────────────────────────────────────
# Transcribe — environment variables (BOTH frontend + backend)
#
# Copy this file to .env at repo root, fill in real values, then:
#   ln -sf $(pwd)/.env frontend/.env.local
#   ln -sf $(pwd)/.env backend/.env
# (or maintain per-app .env files separately if you prefer that ergonomics)
#
# .env* is gitignored except for this .env.example (see .gitignore).
# gitleaks.toml allowlists this file so placeholder formats don't trigger.
# ────────────────────────────────────────────────────────────────────

# ── Supabase (BOTH apps) ──────────────────────────────────────────────
# From your Supabase project's API Settings page.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable / anon key — safe to expose in NEXT_PUBLIC_*.
# Format: sb_publishable_<base64ish>  (or legacy 3-segment JWT eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret / service-role key — NEVER put this in NEXT_PUBLIC_*, NEVER ship to Vercel.
# This belongs ONLY on the backend host (FastAPI machine).
# Format: sb_secret_<base64ish>  (or legacy 3-segment JWT eyJ...)
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (backend only — used by `supabase db push` and any
# direct-connection SQL ops). Get from Supabase → Database → Connection string → "URI".
# The password embedded here is DIFFERENT from the API anon/service-role keys.
# Format: postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_URL=

# ── Hugging Face (backend only — Phase 2 onward) ──────────────────────
# Required by pyannote.audio for diarization model download.
# YOU MUST ALSO visit and accept the licenses on:
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-3.1
# while signed in with the same HF account that owns this token.
# Token-only without prior browser license-accept returns 403 from these models.
# Token format: hf_<34+ alphanumeric chars>
HF_TOKEN=

# ── whisper.cpp model files (backend only — Phase 2 onward) ───────────
# Absolute path to the GGUF model that whisper-cli loads at startup.
# Recommended starter: ggml-medium.bin (~1.5 GB) or ggml-large-v3-turbo.bin (~1.6 GB)
# Download from https://huggingface.co/ggerganov/whisper.cpp ; pin SHA-256 in docs/DEPENDENCIES.md.
WHISPER_MODEL_PATH=/home/YOUR_USER/Code/transcribe/backend/models/ggml-medium.bin

# Path to the whisper.cpp build directory (so the backend can invoke whisper-cli).
# Phase 2 will set this; Phase 1 just documents it.
WHISPER_CPP_BUILD_DIR=/home/YOUR_USER/Code/whisper.cpp/build

# ── Backend HTTP / tunnel (backend only) ──────────────────────────────
BACKEND_HOST=127.0.0.1     # bind to localhost only — cloudflared connects here
BACKEND_PORT=8000

# ── Frontend → Backend wiring ─────────────────────────────────────────
# Update this AFTER each `cloudflared tunnel --url http://localhost:8000` restart.
# The current value is captured in ~/.transcribe/tunnel-url by backend/scripts/tunnel.sh.
# Then run:  vercel env rm NEXT_PUBLIC_BACKEND_URL production --yes
#            echo "$NEW_URL" | vercel env add NEXT_PUBLIC_BACKEND_URL production
#            vercel redeploy --target production
NEXT_PUBLIC_BACKEND_URL=https://CHANGES-EVERY-RESTART.trycloudflare.com

# ── Local dev only ────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Phase 2 backend pipeline ────────────────────────────────────────────
# Path to the locally-built whisper.cpp CLI (see backend/scripts/build_whisper_cpp.sh).
# Wave 2's transcribe.py shells out to this binary. Override with the absolute
# path on this host; the default (if unset) is $HOME/.transcribe/build/whisper.cpp/build/bin/whisper-cli.
WHISPER_BIN_PATH=/home/YOUR_USER/.transcribe/build/whisper.cpp/build/bin/whisper-cli

# Directory containing GGML model weights (see backend/scripts/download_models.sh).
# Default: $HOME/.transcribe/models
MODELS_DIR=/home/YOUR_USER/.transcribe/models

# Silero VAD model path. Pitfall 5: whisper.cpp 1.8+ requires --vad-model FNAME
# alongside --vad. download_models.sh fetches ggml-silero-v5.1.2.bin into
# MODELS_DIR; the lifespan auto-resolves to that filename if this var is empty,
# so most operators do NOT need to set it explicitly.
WHISPER_VAD_MODEL_PATH=

# Per-model SHA-256 pins (recorded in docs/DEPENDENCIES.md after first download).
# download_models.sh verifies the on-disk file against these before reuse.
# Fill these in with the actual SHA-256 sums from docs/DEPENDENCIES.md once the
# models are downloaded; leaving them empty disables the integrity check on re-runs.
MODEL_SMALL_SHA256=
MODEL_MEDIUM_SHA256=
MODEL_TURBO_SHA256=
MODEL_VAD_SILERO_SHA256=29940d98d42b91fbd05ce489f3ecf7c72f0a42f027e4875919a28fb4c04ea2cf

# Disk lifecycle (CORE-07): TUS chunks land in UPLOADS_DIR, get assembled+normalized
# into WORK_DIR, and are deleted from disk after the job completes successfully.
UPLOADS_DIR=/home/YOUR_USER/.transcribe/uploads
WORK_DIR=/home/YOUR_USER/.transcribe/work

# OPTS-07: gate the Slow preset OFF by default. Setting this to true requires
# downloading ggml-large-v3.bin manually (NOT done by download_models.sh on
# the 8 GB Vulkan host because it spills VRAM and is unusable in practice).
ENABLE_SLOW_PRESET=false
